    "eye": { "type": "organ", "slot": "head", "forces": ["Cosmos", "Ouranos", "Eros"], "class": ["organic", "construct", "hybrid"], "rank": "wild" },
    "horn": { "type": "organ", "slot": "head", "forces": ["Gaia", "Chaos"], "class": ["organic", "hybrid"], "rank": "wild" },
    "crest": { "type": "organ", "slot": "head", "forces": ["Ouranos", "Eros"], "class": ["organic", "hybrid"], "rank": "wild" },
