    "soul": { "type": "soul", "slot": "core", "forces": ["Thanatos", "Cosmos"], "class": ["organic", "hybrid"], "rank": "wild" },
    "reactor": { "type": "core", "slot": "core", "forces": ["Cosmos", "Ouranos"], "class": ["construct", "hybrid"], "rank": "wild" },
    "god_core": { "type": "core", "slot": "core", "forces": ["Gaia", "Ouranos", "Cosmos", "Chaos", "Eros", "Thanatos"], "class": ["organic", "construct", "hybrid"], "rank": "god", "raises_tier": true },
    "scale": { "type": "plating", "slot": "hide", "forces": ["Gaia", "Thanatos"], "class": ["organic", "hybrid"], "rank": "wild" },
    "plating": { "type": "plating", "slot": "hide", "forces": ["Gaia", "Cosmos"], "class": ["construct", "hybrid"], "rank": "wild" },
    "crystal_lattice": { "type": "plating", "slot": "hide", "forces": ["Cosmos"], "class": ["construct", "hybrid"], "rank": "wild" },
    "claw": { "type": "organ", "slot": "limb", "forces": ["Chaos", "Thanatos", "Gaia"], "class": ["organic", "hybrid"], "rank": "wild" },
    "wing": { "type": "organ", "slot": "limb", "forces": ["Ouranos", "Eros"], "class": ["organic", "hybrid"], "rank": "wild" },
    "tail": { "type": "organ", "slot": "limb", "forces": ["Chaos", "Ouranos", "Gaia"], "class": ["organic", "hybrid"], "rank": "wild" }
  },
  "gene_compat": {
    "venom": { "type": "gene", "forces": ["Thanatos", "Chaos"], "class": ["organic", "hybrid"], "conflicts_with": ["verdant"] },
    "ironblood": { "type": "gene", "forces": ["Gaia"], "class": ["organic", "construct", "hybrid"], "conflicts_with": [] },
    "quickstep": { "type": "gene", "forces": ["Ouranos"], "class": ["organic", "hybrid"], "conflicts_with": [] },
    "verdant": { "type": "gene", "forces": ["Eros"], "class": ["organic", "hybrid"], "conflicts_with": ["venom"] }
  },
  "bridges": {
    "_doc": "A bridging part lets an organic host accept a construct-only ingredient (and vice-versa) by producing a hybrid class_target (SpliceRules §3 constraint 4).",
    "parts": ["plating", "reactor", "god_core"]
  }
}
