class_name NpcCastCatalog
extends RefCounted
## NpcCastCatalog (Batch E1c) — the authored REGIONAL CASTS as data. Loads
## res://catalog/npc_casts.json (GENERATED by tools/ingest_casts.py from
## docs/content/regional_cast.md + factions_npcs.md: 143 NPCs — 9 faction leaders,
## 27 Hands, the 64-NPC roster, the +43 living-world cast, the wanderers) and shapes
## a region's entries into the SAME def dicts OverworldContent.NPC_DEFS hand-writes,
## so overworld_screen._spawn_npcs consumes either source unchanged.
##
## PRESENTATION/overworld layer, data only. Each catalog def carries:
##   name        the VERBATIM authored name
##   timeline    the scene-id convention '<npc_snake_case>_intro' (E1a generates the
##               timelines in parallel; speak_to falls back to the authored barks
##               below until the .dtl resource exists — the integrator reconciles)
##   ring        the stable hashed Color from the data (deterministic per name)
##   faction/role/barks/bark_key   the authored cast fields
##   cast: true  marks the def catalog-drawn (the bark fallback path keys off it)
## The VERDANT hand-wired cast (OverworldContent.NPC_DEFS) stays canonical in-game.

const CASTS_PATH := "res://catalog/npc_casts.json"

static var _cache: Dictionary = {}  # region_id -> Array[def]
static var _loaded: bool = false


## The screen-shaped NPC defs for a region (copies), [] when the region has no cast entry
## (the caller falls back to the hand-wired defs — absent content never soft-locks).
static func defs_for_region(region_id: String) -> Array:
	var out: Array = []
	for def: Dictionary in _regions().get(region_id, []) as Array:
		out.append(def.duplicate(true))
	return out


## True when the catalog carries a cast for `region_id`.
static func has_region(region_id: String) -> bool:
	return not (_regions().get(region_id, []) as Array).is_empty()


## Region ids carried by the catalog (sorted data order).
static func region_ids() -> Array:
	return _regions().keys()


## TESTS ONLY: drop the static cache so a suite can exercise the load path fresh.
static func reset_cache() -> void:
	_cache = {}
	_loaded = false


# --- internals -------------------------------------------------------------------------------- #


static func _regions() -> Dictionary:
	if _loaded:
		return _cache
	_loaded = true
	if not FileAccess.file_exists(CASTS_PATH):
		push_warning("NpcCastCatalog: missing casts at %s" % CASTS_PATH)
		return _cache
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(CASTS_PATH))
	if not (parsed is Dictionary):
		push_warning("NpcCastCatalog: casts file is not a JSON object")
		return _cache
	var regions: Variant = (parsed as Dictionary).get("regions", {})
	if not (regions is Dictionary):
		return _cache
	for region in regions as Dictionary:
		var defs: Array = []
		for entry in (regions as Dictionary)[region] as Array:
			if entry is Dictionary:
				defs.append(_shape(entry as Dictionary))
		_cache[str(region)] = defs
	return _cache


## One catalog row -> the NPC_DEFS shape the overworld consumes. The ring hex parses into
## a real Color (Color(String) handles "#rrggbb"); barks land verbatim.
static func _shape(entry: Dictionary) -> Dictionary:
	var barks: Array = []
	for bark in entry.get("barks", []) as Array:
		barks.append(str(bark))
	return {
		"name": str(entry.get("name", "")),
		"timeline": str(entry.get("timeline", "")),
		"ring": Color(str(entry.get("ring", "#8a8a8a"))),
		"faction": str(entry.get("faction", "")),
		"role": str(entry.get("role", "")),
		"bark_key": str(entry.get("bark_key", "")),
		"barks": barks,
		"cast": true,
	}
