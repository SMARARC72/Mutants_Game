{"inkVersion":21,"root":[[{"->":"marsh_edge"},["done",{"#n":"g-0"}],null],"done",{"marsh_edge":[["^The marsh exhales. Iron-smelling fog, and something underneath it counting your teeth.","\n","ev","str","^rust_marsh","/str",{"x()":"region_unlocked","exArgs":1},"/ev",[{"->":".^.b","c":true},{"b":["\n","^You have stood here before. The fog remembers, which is worse.","\n",{"->":".^.^.^.10"},null]}],[{"->":".^.b"},{"b":["\n","^The bog has not been formally introduced to you. It introduces itself anyway.","\n",{"->":".^.^.^.10"},null]}],"nop","\n","ev","str","^Kneel and read the rust-omens","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Leave. You have standards. (You do not.)","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["^ ",{"->":"read_omens"},"\n",{"#f":5}],"c-1":["^ ",{"->":"walk_away"},"\n",{"#f":5}]}],null],"read_omens":["ev",true,"/ev",{"VAR=":"quest_rust_marsh_omen_start","re":true},"^The omens spell a name in oxidation. It is, rudely, almost your own.","\n","ev","str","^bog_wretch","/str",{"x()":"has_creature","exArgs":1},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Your bog-wretch hums along, delighted to be referenced.","\n",{"->":".^.^.^.14"},null]}],[{"->":".^.b"},{"b":["\n","^Something out in the reeds would very much like to be caught. Take the hint.","\n",{"->":".^.^.^.14"},null]}],"nop","\n","ev","str","^marsh_encounter","/str","/ev",{"VAR=":"render_timeline","re":true},"done",null],"walk_away":["^You leave. The marsh files a complaint. Corruption noted: ","ev",{"x()":"corruption"},"out","/ev","^.","\n","done",null],"global decl":["ev",false,{"VAR=":"quest_rust_marsh_omen_start"},"str","^","/str",{"VAR=":"quest_rust_marsh_omen_advance"},"str","^","/str",{"VAR=":"render_timeline"},"/ev","end",null]}],"listDefs":{}}