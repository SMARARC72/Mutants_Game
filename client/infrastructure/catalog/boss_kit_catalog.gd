class_name BossKitCatalog
extends RefCounted
## BossKitCatalog (Batch E1c) — the ONLY way the game reads the authored PANTHEON BOSS data.
##
## INFRASTRUCTURE/catalog layer. Loads res://catalog/boss_kits.json (the 25 authored kits —
## GENERATED by tools/ingest_bosses.py from docs/content/pantheon_kits.md) and
## res://catalog/region_bosses.json (the region -> boss_id act-boss slots). Pure read-only
## static DATA: species proxies, library-only skill kits, CombatBrain roles, VERBATIM
## intro/defeat lines. It computes NOTHING — the engines own every number; the kits name
## only skills that already exist in Constants.BALANCE.skill.library (parity-tested).
##
## Lazy static caching mirrors EncounterCatalog._slice(): both files parse once per process
## and the catalog stays cheap to consult from the static EncounterCatalog read sites.

const KITS_PATH := "res://catalog/boss_kits.json"
const REGIONS_PATH := "res://catalog/region_bosses.json"

static var _kits_cache: Dictionary = {}  # boss_id -> boss row
static var _kits_loaded: bool = false
static var _regions_cache: Dictionary = {}  # region_id -> boss_id
static var _regions_loaded: bool = false


## The boss row for `boss_id` ({} when unknown): {boss_id, name, rank, forces, region,
## species_id, species_resolution, role, kit, signature_skill, intro_line, defeat_line,
## phase_flavor, ...}. Defensive copy — a caller can never mutate the shared row.
static func boss_by_id(boss_id: String) -> Dictionary:
	var row: Dictionary = _kits().get(boss_id, {})
	return row.duplicate(true)


## Every boss row, in authored (doc) order. Array[Dictionary] copies.
static func all_bosses() -> Array:
	var out: Array = []
	for boss_id in _kits():
		out.append((_kits()[boss_id] as Dictionary).duplicate(true))
	return out


## How many boss kits are loaded (25 when the data file is present + parses).
static func count() -> int:
	return _kits().size()


## The act-boss id assigned to `region_id`, or "" (the hub / unassigned regions).
static func boss_id_for_region(region_id: String) -> String:
	return str(_regions().get(region_id, ""))


## The region -> boss_id map (copy) — the E1b-reconcilable act-boss slots.
static func region_bosses() -> Dictionary:
	return _regions().duplicate(true)


## The EncounterCatalog-shaped boss CONFIG for a region's act boss, or {} when the region
## has no assigned boss / the boss's species proxy is unresolved. Shape (a superset of the
## slice_verdant boss dict, so EncounterDirector.boss_step consumes it unchanged):
##   { species_id, name, brain, rank, boss_id, kit: Array[String],
##     intro_line, defeat_line }
## The boss keeps its AUTHORED name via the encounter nickname; `brain` is the boss row's
## CombatBrain role; `kit` is the library-only kit the SkillMonFactory override consumes.
static func boss_config_for_region(region_id: String) -> Dictionary:
	var boss_id := boss_id_for_region(region_id)
	if boss_id == "":
		return {}
	var row := boss_by_id(boss_id)
	var species_id := str(row.get("species_id", ""))
	if species_id == "":
		return {}
	return {
		"species_id": species_id,
		"name": str(row.get("name", boss_id)),
		"brain": str(row.get("role", "controller")),
		"rank": str(row.get("rank", "god")),
		"boss_id": boss_id,
		"kit": (row.get("kit", []) as Array).duplicate(),
		"intro_line": str(row.get("intro_line", "")),
		"defeat_line": str(row.get("defeat_line", "")),
	}


## TESTS ONLY: drop the static caches so a suite can exercise the load path fresh.
static func reset_cache() -> void:
	_kits_cache = {}
	_kits_loaded = false
	_regions_cache = {}
	_regions_loaded = false


# --- internals -------------------------------------------------------------------------------- #


static func _kits() -> Dictionary:
	if _kits_loaded:
		return _kits_cache
	_kits_loaded = true
	var parsed := _parse(KITS_PATH)
	var rows: Variant = parsed.get("bosses", [])
	if rows is Array:
		for row in rows as Array:
			if row is Dictionary and str((row as Dictionary).get("boss_id", "")) != "":
				_kits_cache[str((row as Dictionary)["boss_id"])] = row
	return _kits_cache


static func _regions() -> Dictionary:
	if _regions_loaded:
		return _regions_cache
	_regions_loaded = true
	var parsed := _parse(REGIONS_PATH)
	var map: Variant = parsed.get("region_bosses", {})
	if map is Dictionary:
		for region in map as Dictionary:
			_regions_cache[str(region)] = str((map as Dictionary)[region])
	return _regions_cache


## Parse a catalog JSON object, {} when missing/malformed (the trigger then never fires —
## mirrors the EncounterCatalog fallback philosophy: absent content never soft-locks).
static func _parse(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		push_warning("BossKitCatalog: missing catalog at %s" % path)
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if parsed is Dictionary:
		return parsed as Dictionary
	push_warning("BossKitCatalog: catalog at %s is not a JSON object" % path)
	return {}
