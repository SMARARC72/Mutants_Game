class_name EndingsService
extends RefCounted
## Parse-once loader + resolver of the AUTHORED endings catalog (Batch E2b).
##
## `res://catalog/endings.json` is GENERATED by tools/ingest_endings.py from
## docs/content/endgame_succession.md (the eleven endings + one documented
## fallback) — edit the source doc and re-run the tool; never hand-edit the
## JSON. Every mapping decision is recorded in tools/INGEST_NOTES.md (E2b).
##
## resolve(run) returns the highest-priority ending whose conditions the run
## satisfies. The nine grid ascensions band the run's morality axes EXACTLY
## like CharacterEngine/the character sheet (band3, thresholds ±34), so the
## sheet's god cell and the resolved ending can never disagree; the two
## refusal doors ride their run flags (`unmaking` / `god_maker` — the
## wave/e2-arc seam); the fallback entry is always satisfiable, so resolve()
## NEVER returns an empty ending once the finale flag lands. APPLICATION
## layer: data + banding only — no gameplay number is computed here.

const MortalityServiceScript := preload("res://application/game/mortality_service.gd")

const CATALOG_PATH := "res://catalog/endings.json"

## The run.flags key the ending screen latches the resolved ending id into —
## a non-empty value marks the save's ledger CLOSED (the Continue gate reads it).
const ENDING_FLAG := "ending_id"

## The finale trigger flags (either closes the record): `succession_begins` is
## the wave/e2-arc Choice seam; `act5_q4_done` is the doc-pure act-5 climax
## flag the ingested quest chain sets (the integrator reconciles the pair).
const FINALE_FLAGS: Array = ["succession_begins", "act5_q4_done"]

## band3 label rows — the same order the oracle/character sheet uses.
const OC_LABELS: Array = ["Order", "Balanced", "Chaos"]

## Last-resort ending if the catalog itself is missing/malformed: the same
## documented fallback entry the tool emits, hard-coded so resolve() keeps its
## never-null contract even against a broken install.
const BUILTIN_FALLBACK := {
	"id": "a_graveyard_of_winners",
	"name": "A Graveyard of Winners",
	"epithet": "",
	"grid": "",
	"epigraph": "the gods are mostly dead — and one of them used to be you.",
	"conditions": {},
	"priority": 0,
	"fallback": true,
}

static var _endings: Array = []
static var _loaded := false


## Every catalog entry (raw ingest shape), parsed once per session.
static func endings() -> Array:
	if not _loaded:
		_endings = _parse()
		_loaded = true
	return _endings


## The entry with `id`, or {} when unknown.
static func ending(ending_id: String) -> Dictionary:
	for e: Dictionary in endings():
		if str(e.get("id", "")) == ending_id:
			return e
	return {}


## The highest-priority ending whose conditions `run` satisfies (catalog order
## breaks priority ties). NEVER empty: the catalog's always-true fallback (or
## the built-in copy) answers when nothing else does — including run == null.
static func resolve(run: RunContext) -> Dictionary:
	var best: Dictionary = {}
	var best_priority := -1
	for e: Dictionary in endings():
		var priority := int(e.get("priority", 0))
		if priority <= best_priority:
			continue
		if conditions_met(e.get("conditions", {}) as Dictionary, run):
			best = e
			best_priority = priority
	if best.is_empty():
		return BUILTIN_FALLBACK.duplicate(true)
	return best


## True when `run` satisfies every clause of `conditions` (empty = always).
## Clauses: god_alignment (Order⇄Chaos band label), corruption_min/_max
## (bounds on the CLAMPED Purity⇄Corrupt axis — the corruption-band axis of
## the 9-god grid, NOT the ADR-014 price meter), flags_all / flags_any
## (truthy run flags), standing_min (["<faction>", min] against the
## `<faction>_standing` run flag).
static func conditions_met(conditions: Dictionary, run: RunContext) -> bool:
	if conditions.is_empty():
		return true
	if run == null:
		return false
	if conditions.has("god_alignment"):
		var oc := CharacterEngine.band3(CharacterEngine.clamp_axis(run.order_chaos), OC_LABELS)
		if oc != str(conditions.god_alignment):
			return false
	var pc := CharacterEngine.clamp_axis(run.purity_corrupt)
	if conditions.has("corruption_min") and pc < int(conditions.corruption_min):
		return false
	if conditions.has("corruption_max") and pc > int(conditions.corruption_max):
		return false
	for flag: Variant in conditions.get("flags_all", []) as Array:
		if not bool(run.flags.get(str(flag), false)):
			return false
	var any_flags: Array = conditions.get("flags_any", []) as Array
	if not any_flags.is_empty():
		var hit := false
		for flag: Variant in any_flags:
			if bool(run.flags.get(str(flag), false)):
				hit = true
				break
		if not hit:
			return false
	if conditions.has("standing_min"):
		var pair: Array = conditions.standing_min as Array
		if pair.size() == 2:
			var standing := int(run.flags.get("%s_standing" % str(pair[0]), 0))
			if standing < int(pair[1]):
				return false
	return true


## True once the run's finale flag has landed (the record is closing): either
## the e2-arc `succession_begins` seam or the ingested act-5 climax done flag.
static func finale_reached(run: RunContext) -> bool:
	if run == null:
		return false
	for flag: Variant in FINALE_FLAGS:
		if bool(run.flags.get(str(flag), false)):
			return true
	return false


## The ending id already latched on this run ("" when the ledger is open).
static func recorded_ending(run: RunContext) -> String:
	if run == null:
		return ""
	return str(run.flags.get(ENDING_FLAG, ""))


## Latch the resolved ending id into run.flags (idempotent — the FIRST record
## wins; a finished ledger never re-resolves). True only on the first latch.
static func record(run: RunContext, ending_id: String) -> bool:
	if run == null or ending_id == "" or recorded_ending(run) != "":
		return false
	run.flags[ENDING_FLAG] = ending_id
	return true


## The run's closing LEDGER, read from run fields (data only, no math):
## caught/spliced count lineage marks across the living party AND the
## graveyard (the dead still count — they were caught/spliced too); lost is
## the memorial ledger's size; corruption is the ADR-014 price meter;
## standing is the tracked Bloomwardens value.
static func run_ledger(run: RunContext) -> Dictionary:
	var ledger := {"caught": 0, "spliced": 0, "lost": 0, "corruption": 0, "standing": 0}
	if run == null:
		return ledger
	var graveyard: Array = MortalityServiceScript.graveyard_of(run)
	ledger.lost = graveyard.size()
	ledger.corruption = run.corruption
	ledger.standing = int(run.flags.get("bloomwardens_standing", 0))
	var creatures: Array = run.party.duplicate()
	for memorial: Variant in graveyard:
		if memorial is Dictionary:
			creatures.append((memorial as Dictionary).get("creature", {}))
	for entry: Variant in creatures:
		if not (entry is Dictionary):
			continue
		var lineage_v: Variant = (entry as Dictionary).get("lineage", {})
		var lineage: Dictionary = lineage_v if lineage_v is Dictionary else {}
		if bool(lineage.get("captured", false)):
			ledger.caught += 1
		if bool(lineage.get("spliced", false)):
			ledger.spliced += 1
	return ledger


static func _parse() -> Array:
	var text := FileAccess.get_file_as_string(CATALOG_PATH)
	if text == "":
		push_error("EndingsService: missing or empty %s" % CATALOG_PATH)
		return []
	var data: Variant = JSON.parse_string(text)
	if not (data is Dictionary):
		push_error("EndingsService: malformed %s" % CATALOG_PATH)
		return []
	return (data as Dictionary).get("endings", []) as Array
