class_name QuestCatalog
extends RefCounted
## Parse-once loader of the AUTHORED quest catalog (Batch E1a).
##
## `res://catalog/quests.json` is GENERATED by tools/ingest_quests.py from
## docs/content/story_quests.md (24 main quests, 6 acts) + side_quests.md (28) —
## edit the source docs and re-run the tool; never hand-edit the JSON. This
## loader turns catalog entries into the exact QuestService definition shape the
## overworld already drives (id/name/description/step_key/steps/trigger/
## on_complete), so authored quests register, gate, walk, persist, and surface
## in the Journal + HUD through the proven pipeline with zero new dispatch code.
##
## Availability gating: a quest's `prereq_flags` (the doc-derived act-gate chain
## — see tools/INGEST_NOTES.md) becomes the QuestService `trigger` predicate,
## checked against run flags at start(). The hand-wired Act-0 spine stays
## canonical: its climax sets `registered_aspirant`, which ACT_GATE_ALIASES
## bridges onto the catalog's doc-pure `act1_open` gate for the union path.

const CATALOG_PATH := "res://catalog/quests.json"

## Hand-wired act-gate bridge (union path only): the canonical Act-0 climax
## (OverworldContent.REGISTERED_QUEST) sets `registered_aspirant`, so the
## catalog's act-1 gate listens for THAT flag when riding beside the hand-wired
## spine. The raw catalog chain (acts walked pure) keeps `act1_open` untouched.
const ACT_GATE_ALIASES := {"act1_open": "registered_aspirant"}

static var _entries: Array = []
static var _loaded := false
static var _region_defs: Dictionary = {}  # region_id -> Array[def] (built once)


## Every catalog entry (raw ingest shape), parsed once per session.
static func entries() -> Array:
	if not _loaded:
		_entries = _parse()
		_loaded = true
	return _entries


## The raw entry with `id`, or {} when unknown.
static func entry(quest_id: String) -> Dictionary:
	for e: Dictionary in entries():
		if str(e.get("id", "")) == quest_id:
			return e
	return {}


## How many catalog quests of `kind` ("main" | "side") were ingested.
static func count(kind: String) -> int:
	var total := 0
	for e: Dictionary in entries():
		if str(e.get("kind", "")) == kind:
			total += 1
	return total


## QuestService-shaped defs for the ACTIVE region: entries whose region is the
## active region, "threshold" (the hub rides the shipped region — the W16b
## pattern), or "" (the region-agnostic main spine). Act gates ride each def's
## trigger, aliased onto the hand-wired flags. Cached per region (the HUD and
## Journal re-read defs every refresh).
static func defs_for_region(region_id: String) -> Array:
	if _region_defs.has(region_id):
		return _region_defs[region_id]
	var out: Array = []
	for e: Dictionary in entries():
		var region: String = str(e.get("region", ""))
		if region != "" and region != "threshold" and region != region_id:
			continue
		out.append(to_def(e, true))
	_region_defs[region_id] = out
	return out


## A catalog entry as a QuestService definition. `aliased` maps act-gate flags
## through ACT_GATE_ALIASES (the union-with-hand-wired path); the raw catalog
## chain (parity tests, future full-region registration) stays doc-pure.
static func to_def(e: Dictionary, aliased := false) -> Dictionary:
	var steps: Array = []
	var quest_step_key := ""
	for s: Dictionary in e.get("steps", []) as Array:
		if quest_step_key == "":
			quest_step_key = str(s.get("step_key", ""))
		(
			steps
			. append(
				{
					"id": str(s.get("id", "")),
					"description": str(s.get("objective_text", "")),
					"on_complete": (s.get("on_complete", {}) as Dictionary).duplicate(true),
				}
			)
		)
	var def := {
		"id": str(e.get("id", "")),
		"name": str(e.get("title", "")),
		"description": _description_for(steps),
		"step_key": quest_step_key,
		"steps": steps,
		"on_complete": (e.get("on_complete", {}) as Dictionary).duplicate(true),
	}
	var prereqs: Array = e.get("prereq_flags", []) as Array
	if not prereqs.is_empty():
		var flag: String = str(prereqs[0])
		if aliased:
			flag = str(ACT_GATE_ALIASES.get(flag, flag))
		def["trigger"] = {"flag": flag}
	return def


static func _description_for(steps: Array) -> String:
	if steps.is_empty():
		return ""
	return str((steps[0] as Dictionary).get("description", ""))


static func _parse() -> Array:
	var text := FileAccess.get_file_as_string(CATALOG_PATH)
	if text == "":
		push_error("QuestCatalog: missing or empty %s" % CATALOG_PATH)
		return []
	var data: Variant = JSON.parse_string(text)
	if not (data is Dictionary):
		push_error("QuestCatalog: malformed %s" % CATALOG_PATH)
		return []
	var quests: Array = (data as Dictionary).get("quests", []) as Array
	return quests
