; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mutants_Game"
config/description="A funny-grim, mature-occult creature-collection RPG."
config/version="0.1.0"
run/main_scene="res://presentation/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Supabase="*res://addons/supabase/Supabase/supabase.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
Questify="*res://addons/questify/quest_manager.gd"
__InkRuntime="*res://addons/inkgd/ink_runtime.gd"
GUIDE="*res://addons/guide/guide.gd"
LimboConsole="*res://addons/limbo_console/limbo_console.gd"
Settings="*res://autoload/settings.gd"
ThemeService="*res://autoload/theme_service.gd"
InputService="*res://infrastructure/input/input_service.gd"
Toast="*res://presentation/ui/toast/toast.gd"
Transition="*res://presentation/ui/transition/transition.gd"
DevConsole="*res://presentation/devtools/dev_console.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"marsh_encounter": "res://presentation/dialogue/marsh_encounter.dtl",
"smoke": "res://presentation/dialogue/smoke.dtl"
}
layout/style_directory={}

[dotnet]

project/assembly_name="Mutants_Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/csv-data-importer/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/inkgd/plugin.cfg", "res://addons/limbo_console/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/questify/plugin.cfg", "res://addons/supabase/plugin.cfg")

[inkgd]

register_templates=true

[questify]

general/update_polling=false
general/update_interval=0.5
general/add_quests_to_pot_generation=false

[input]

limbo_console_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194337,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
