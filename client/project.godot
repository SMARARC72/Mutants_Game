; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mutants_Game"
config/description="A funny-grim, mature-occult creature-collection RPG."
config/version="0.1.0"
run/main_scene="res://presentation/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.090196, 0.07451, 0.109804, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
config/icon="res://icon.svg"

[autoload]

Supabase="*uid://cgwqtrsm3o3e8"
Dialogic="*uid://ds2q0uclmolvu"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Questify="*uid://b07jy1yytqpum"
__InkRuntime="*res://addons/inkgd/ink_runtime.gd"
GUIDE="*res://addons/guide/guide.gd"
LimboConsole="*res://addons/limbo_console/limbo_console.gd"
Settings="*res://autoload/settings.gd"
SfxService="*res://autoload/sfx_service.gd"
MusicService="*res://autoload/music_service.gd"
ThemeService="*res://autoload/theme_service.gd"
InputService="*res://infrastructure/input/input_service.gd"
Toast="*res://presentation/ui/toast/toast.gd"
Transition="*res://presentation/ui/transition/transition.gd"
DevConsole="*res://presentation/devtools/dev_console.gd"
GameController="*res://application/game/game_controller.gd"

