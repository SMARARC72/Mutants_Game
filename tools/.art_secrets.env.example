# tools/.art_secrets.env.example — local key for the offline art pipeline (tools/gen_art.py).
# Copy this file to tools/.art_secrets.env and paste your real key. The real file is gitignored
# (see .gitignore: tools/.art_secrets.env) — NEVER commit a real key.
#
# Alternatively, just export the env var instead of using this file:
#   export OPENAI_API_KEY=...        (bash)
#   $env:OPENAI_API_KEY = "..."      (PowerShell)
# The env var takes precedence over this file. With neither set, gen_art.py runs in --dry-run.

OPENAI_API_KEY=__paste_your_openai_key_here__
