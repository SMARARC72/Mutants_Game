# services/.env.example — REQUIRED server-side environment (TDD §9.2).
# Copy to a Vercel project env (per environment: dev/preview/prod). NEVER commit a real .env.
# These are PRIVILEGED secrets and are never returned to or shipped in the client.
# The client ships only the Supabase URL + ANON key (which are NOT in this file).

# Supabase project URL (also used to derive the JWKS endpoint for JWT verification).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service-role key — bypasses RLS; used only for the specific privileged writes these
# functions own (art_assets reservation, god_snapshots insert). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=__set_in_vercel_env__

# OpenAI key — the gen proxy is the ONLY holder (ADR-007).
OPENAI_API_KEY=__set_in_vercel_env__

# Optional overrides (defaults applied if unset):
# ART_BUCKET=creature-art
# ART_RATE_LIMIT_PER_MINUTE=6
# ART_MONTHLY_CAP=200
